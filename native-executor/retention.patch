+async fn retention_close_probe_session_over_websocket() -> anyhow::Result<()> {
+    let mut server = exec_server().await?;
+    let initialize_id = server
+        .send_request(
+            "initialize",
+            serde_json::json!({ "clientName": "temporary-probe" }),
+        )
+        .await?;
+    let initialized = server
+        .wait_for_event(|event| {
+            matches!(event, JSONRPCMessage::Response(JSONRPCResponse { id, .. })
+                | JSONRPCMessage::Error(JSONRPCError { id, .. }) if id == &initialize_id)
+        })
+        .await?;
+    let JSONRPCMessage::Response(JSONRPCResponse { result, .. }) = initialized else {
+        anyhow::bail!("expected initialize response, got {initialized:?}");
+    };
+    let initialized: InitializeResponse = serde_json::from_value(result)?;
+    server
+        .send_notification("initialized", serde_json::json!({}))
+        .await?;
+    let close_id = server
+        .send_request("session/close", serde_json::json!({}))
+        .await?;
+    let closed = server
+        .wait_for_event(|event| {
+            matches!(event, JSONRPCMessage::Response(JSONRPCResponse { id, .. })
+                | JSONRPCMessage::Error(JSONRPCError { id, .. }) if id == &close_id)
+        })
+        .await?;
+    let JSONRPCMessage::Response(JSONRPCResponse { result, .. }) = closed else {
+        anyhow::bail!("expected session/close response, got {closed:?}");
+    };
+    assert_eq!(result, serde_json::json!({}));
+    server.disconnect_websocket().await?;
+    server.reconnect_websocket().await?;
+    let resume_id = server
+        .send_request(
+            "initialize",
+            serde_json::json!({
+                "clientName": "closed-probe",
+                "resumeSessionId": initialized.session_id
+            }),
+        )
+        .await?;
+    let resumed = server
+        .wait_for_event(|event| {
+            matches!(event, JSONRPCMessage::Response(JSONRPCResponse { id, .. })
+                | JSONRPCMessage::Error(JSONRPCError { id, .. }) if id == &resume_id)
+        })
+        .await?;
+    let JSONRPCMessage::Error(JSONRPCError { error, .. }) = resumed else {
+        anyhow::bail!("closed session must not resume, got {resumed:?}");
+    };
+    assert_eq!(error.code, -32600);
+    assert!(error.message.contains("unknown session id"));
+    server.shutdown().await?;
+    Ok(())
+}
