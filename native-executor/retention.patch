+        resume: Option<String>,
+        retention: Option<Duration>,
+    ) -> Result<SessionHandle, JSONRPCErrorError> {
+        let (sender, _receiver) = mpsc::channel(16);
+        let runtime = ExecServerRuntimeOptions::new(std::env::current_exe().unwrap(), None)
+            .unwrap()
+            .with_detached_session_retention(retention)
+            .unwrap();
+        registry
+            .attach(resume, RpcNotificationSender::new(sender), runtime)
+            .await
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn unlimited_retention_resumes_the_same_entry_after_an_hour() {
+        let registry = SessionRegistry::default();
+        let registry = Arc::new(registry);
+        let first = attach(&registry, None, None).await.unwrap();
+        let id = first.session_id().to_string();
+        first.detach().await;
+        tokio::time::advance(Duration::from_secs(3_600)).await;
+        let resumed = attach(&registry, Some(id.clone()), None).await.unwrap();
+        assert_eq!(id, resumed.session_id());
+        assert!(Arc::ptr_eq(&first.entry, &resumed.entry));
+        assert!(!first.is_session_attached());
+        assert!(resumed.is_session_attached());
+        registry.shutdown().await;
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn explicit_finite_retention_expires_instead_of_creating_a_new_session() {
+        let registry = SessionRegistry::new(ExecServerTelemetry::default());
+        let session = attach(&registry, None, Some(Duration::from_secs(2)))
+            .await
+            .unwrap();
+        let id = session.session_id().to_string();
+        session.detach().await;
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_secs(3)).await;
+        tokio::task::yield_now().await;
+        assert!(registry.sessions.lock().await.is_empty());
+        let error = attach(&registry, Some(id), None).await.err().unwrap();
+        assert!(error.message.contains("unknown session id"));
+        assert!(registry.sessions.lock().await.is_empty());
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn old_expiry_timer_does_not_remove_a_new_attachment_or_detachment() {
+        let registry = SessionRegistry::new(ExecServerTelemetry::default());
+        let first = attach(&registry, None, Some(Duration::from_secs(2)))
+            .await
+            .unwrap();
+        let id = first.session_id().to_string();
+        first.detach().await;
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_secs(1)).await;
+        let second = attach(&registry, Some(id.clone()), None).await.unwrap();
+        second.detach().await;
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_millis(1_500)).await;
+        tokio::task::yield_now().await;
+        assert!(registry.sessions.lock().await.contains_key(&id));
+        tokio::time::advance(Duration::from_secs(1)).await;
+        tokio::task::yield_now().await;
+        assert!(registry.sessions.lock().await.is_empty());
+    }
+
+    #[tokio::test]
+    async fn explicit_close_removes_only_the_callers_session() {
+        let registry = SessionRegistry::new(ExecServerTelemetry::default());
+        let first = attach(&registry, None, None).await.unwrap();
+        let other = attach(&registry, None, None).await.unwrap();
+        first.close().await.unwrap();
+        assert!(!first.is_session_attached());
+        assert!(other.is_session_attached());
+        assert_eq!(1, registry.sessions.lock().await.len());
+        first.detach().await; // Transport cleanup must not retain or recreate the closed entry.
+        let result = attach(&registry, Some(first.session_id().to_string()), None).await;
+        assert!(result.err().unwrap().message.contains("unknown session id"));
+        other.close().await.unwrap();
+        assert!(registry.sessions.lock().await.is_empty());
+    }
+
+    #[tokio::test]
+    async fn stale_connection_cannot_close_the_resumed_session() {
+        let registry = SessionRegistry::new(ExecServerTelemetry::default());
+        let first = attach(&registry, None, None).await.unwrap();
+        first.detach().await;
+        let resumed = attach(&registry, Some(first.session_id().to_string()), None)
+            .await
+            .unwrap();
+        assert!(first.close().await.is_err());
+        assert!(resumed.is_session_attached());
+        assert_eq!(1, registry.sessions.lock().await.len());
+        resumed.close().await.unwrap();
+    }
+
+    #[tokio::test]
+    async fn executor_shutdown_removes_even_unlimited_detached_sessions() {
+        let registry = SessionRegistry::new(ExecServerTelemetry::default());
+        let first = attach(&registry, None, None).await.unwrap();
+        first.detach().await;
+        registry.shutdown().await;
+        assert!(registry.sessions.lock().await.is_empty());
+        assert!(
+            attach(&registry, Some(first.session_id().to_string()), None)
+                .await
+                .is_err()
+        );
+    }
+}
