+#[tokio::test]
+async fn retention_session_close_cleans_one_session_and_preserves_another() {
+    let registry = SessionRegistry::new(crate::ExecServerTelemetry::default());
+    let (first_tx, _first_rx) = mpsc::channel(32);
+    let first = ExecServerHandler::new(
+        Arc::clone(&registry),
+        RpcNotificationSender::new(first_tx),
+        test_runtime_paths(),
+        test_http_client_factory(),
+    );
+    let initialized = first
+        .initialize(InitializeParams {
+            client_name: "probe".to_string(),
+            resume_session_id: None,
+        })
+        .await
+        .unwrap();
+    first.initialized().unwrap();
+    first
+        .exec(
+            exec_params_with_argv(
+                "closed-process",
+                shell_argv("sleep 60", "ping -n 61 127.0.0.1 >NUL"),
+            ),
+            None,
+        )
+        .await
+        .unwrap();
+    let (other_tx, _other_rx) = mpsc::channel(32);
+    let other = ExecServerHandler::new(
+        Arc::clone(&registry),
+        RpcNotificationSender::new(other_tx),
+        test_runtime_paths(),
+        test_http_client_factory(),
+    );
+    other
+        .initialize(InitializeParams {
+            client_name: "personal".to_string(),
+            resume_session_id: None,
+        })
+        .await
+        .unwrap();
+    other.initialized().unwrap();
+    other
+        .exec(
+            exec_params_with_argv(
+                "retained-process",
+                shell_argv("sleep 60", "ping -n 61 127.0.0.1 >NUL"),
+            ),
+            None,
+        )
+        .await
+        .unwrap();
+    first.session_close().await.unwrap();
+    assert!(!first.is_session_attached());
+    assert!(first.environment_info().is_err());
+    let (resume_tx, _resume_rx) = mpsc::channel(16);
+    let resume = ExecServerHandler::new(
+        Arc::clone(&registry),
+        RpcNotificationSender::new(resume_tx),
+        test_runtime_paths(),
+        test_http_client_factory(),
+    );
+    assert!(
+        resume
+            .initialize(InitializeParams {
+                client_name: "closed-resume".to_string(),
+                resume_session_id: Some(initialized.session_id),
+            })
+            .await
+            .unwrap_err()
+            .message
+            .contains("unknown session id")
+    );
+    let running = other
+        .exec_read(ReadParams {
+            process_id: ProcessId::from("retained-process"),
+            after_seq: None,
+            max_bytes: None,
+            wait_ms: Some(0),
+        })
+        .await
+        .unwrap();
+    assert!(!running.exited);
+    assert!(!running.closed);
+    assert!(running.failure.is_none());
+    other.session_close().await.unwrap();
+    first.shutdown().await;
+    other.shutdown().await;
+    registry.shutdown().await;
+}
